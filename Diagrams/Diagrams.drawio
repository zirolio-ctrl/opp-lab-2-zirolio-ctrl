        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautoactivate on\nskinparam sequence {\n  LifeLineBorderColor #444444\n  LifeLineBackgroundColor #DDEEFF\n  ParticipantPadding 15\n}\n\nactor \&quot;Користувач\&quot; as User\nparticipant \&quot;MainWindow\&quot; as View\nparticipant \&quot;MainViewModel\&quot; as VM\nparticipant \&quot;DialogService\&quot; as Dlg\nparticipant \&quot;стратегія :\\nIXmlSearchStrategy\&quot; as Strat\nparticipant \&quot;ExportFormatFactory\&quot; as Fac\nparticipant \&quot;формат :\\nIExportFormat\&quot; as Fmt\nparticipant \&quot;EventLogger\&quot; as Log\nparticipant \&quot;GoogleDriveService\&quot; as Drive\n\n== Відкриття файлу ==\nUser -&gt; View : натискає «Відкрити XML»\n  View -&gt; VM : OpenXmlCommand\n    VM -&gt; Dlg : PickXmlFileAsync()\n    return path\n    VM -&gt; VM : LoadXmlData(path)\n      VM -&gt; VM : Fill(Faculties / Courses / Rooms)\n      return\n      VM -&gt; VM : Search()\n      return\n    return\n  return\nreturn\n\n== Пошук ==\nUser -&gt; View : обирає алгоритм і фільтри,\\nнатискає «Пошук»\n  View -&gt; VM : SearchCommand\n    VM -&gt; Strat : Search(filePath, faculty, course, room)\n    return List&lt;StudentRecord&gt;\n    VM -&gt; Log : Log(\&quot;Фільтрація\&quot;, параметри)\n    return\n    VM -&gt; VM : оновлює SearchResults, StatusMessage\n    return\n  return\nreturn\n\n== Експорт результату ==\nUser -&gt; View : натискає «Зберегти результат»\n  View -&gt; VM : ExportCommand\n    VM -&gt; Fac : Create(ExportFormat)\n    return IExportFormat\n    VM -&gt; Fmt : Build(SearchResults)\n    return content\n\n    opt ExportTarget ≠ «Google Drive»\n      VM -&gt; Dlg : PickSaveFileAsync(fileName, ext)\n      return path\n      VM -&gt; VM : File.WriteAllTextAsync(path, content)\n      return\n      VM -&gt; Log : Log(\&quot;Збереження\&quot;, \&quot;Локально\&quot;)\n      return\n    end\n\n    opt ExportTarget ≠ «Локально»\n      alt client_secret.json знайдено\n        VM -&gt; Drive : UploadAsync(fileName, content, mimeType)\n        return webViewLink\n        VM -&gt; Log : Log(\&quot;Збереження\&quot;, \&quot;Google Drive\&quot;)\n        return\n      else файл відсутній\n        VM -&gt; VM : StatusMessage = «відсутній client_secret.json»\n        return\n      end\n    end\n  return\nreturn\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8wH4KUpo3qq15doBGJg6-1">
