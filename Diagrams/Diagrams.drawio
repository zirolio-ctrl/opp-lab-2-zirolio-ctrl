        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam actorStyle awesome\n\nactor \&quot;Користувач\&quot; as User\n\nrectangle \&quot;Інформаційна система «Гуртожиток» (Avalonia UI)\&quot; {\n\n    &#39; Завантаження та вибір файлу\n    usecase \&quot;Вибір та відкриття XML-файлу\&quot; as UC_OpenXml\n    usecase \&quot;Динамічне завантаження критеріїв пошуку\&quot; as UC_LoadCriteria\n\n    &#39; Пошук та аналіз\n    usecase \&quot;Пошук студента за критеріями\&quot; as UC_Search\n    usecase \&quot;Вибір алгоритму аналізу (Strategy)\&quot; as UC_SelectStrategy\n    usecase \&quot;Пошук через SAX API (XmlReader)\&quot; as UC_Sax\n    usecase \&quot;Пошук через DOM API (XmlDocument)\&quot; as UC_Dom\n    usecase \&quot;Пошук через LINQ to XML (XDocument)\&quot; as UC_Linq\n    \n    &#39; Допоміжні функції пошуку\n    usecase \&quot;Відображення повідомлення «Нічого не знайдено»\&quot; as UC_NoResults\n\n    &#39; Трансформація\n    usecase \&quot;Трансформація XML в HTML\&quot; as UC_Transform\n    usecase \&quot;Застосування XSLT шаблону (.xsl)\&quot; as UC_ApplyXslt\n    usecase \&quot;Автоматичне відкриття HTML у браузері\&quot; as UC_OpenHtml\n\n    &#39; Скидання та Очищення\n    usecase \&quot;Очищення форми та результатів (Clear)\&quot; as UC_Clear\n\n    &#39; Завершення роботи\n    usecase \&quot;Завершення роботи з програмою\&quot; as UC_Exit\n    usecase \&quot;Підтвердження виходу («Так / Ні»)\&quot; as UC_ConfirmExit\n}\n\n&#39; Зв&#39;язки користувача з основними сценаріями\nUser --&gt; UC_OpenXml\nUser --&gt; UC_Search\nUser --&gt; UC_Transform\nUser --&gt; UC_Clear\nUser --&gt; UC_Exit\n\n&#39; &lt;&lt;include&gt;&gt; : Обов&#39;язкові вкладені кроки\nUC_OpenXml ..&gt; UC_LoadCriteria : &lt;&lt;include&gt;&gt;\nUC_Search ..&gt; UC_SelectStrategy : &lt;&lt;include&gt;&gt;\nUC_Transform ..&gt; UC_ApplyXslt : &lt;&lt;include&gt;&gt;\nUC_Exit ..&gt; UC_ConfirmExit : &lt;&lt;include&gt;&gt;\n\n&#39; Реалізація паттерна Strategy (вибір однієї зі стратегій)\nUC_SelectStrategy &lt;|-- UC_Sax\nUC_SelectStrategy &lt;|-- UC_Dom\nUC_SelectStrategy &lt;|-- UC_Linq\n\n&#39; &lt;&lt;extend&gt;&gt; : Додаткові / опціональні сценарії за певних умов\nUC_NoResults .&gt; UC_Search : &lt;&lt;extend&gt;&gt; \\n (якщо 0 результатів)\nUC_OpenHtml .&gt; UC_Transform : &lt;&lt;extend&gt;&gt; \\n (якщо конвертація успішна)\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EHbFvdvwOwFhv5yeqIry-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
