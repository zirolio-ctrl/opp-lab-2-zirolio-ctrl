  <diagram id="HI292Owxrfi19eqTYI63" name="Страница-2">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nhide empty members\n\n&#39; ===== Внешние типы (Avalonia / CommunityToolkit) =====\nclass \&quot;Application\&quot; as AvApplication &lt;&lt;Avalonia&gt;&gt;\nclass \&quot;Window\&quot; as AvWindow &lt;&lt;Avalonia&gt;&gt;\ninterface \&quot;IDataTemplate\&quot; as AvIDataTemplate &lt;&lt;Avalonia&gt;&gt;\nabstract class \&quot;ObservableObject\&quot; as ObservableObject &lt;&lt;CommunityToolkit.Mvvm&gt;&gt;\n\n&#39; ===== Корень приложения =====\nclass Program &lt;&lt;sealed&gt;&gt; {\n  +{static} Main(args : string[])\n  +{static} BuildAvaloniaApp() : AppBuilder\n}\n\nclass App {\n  +Initialize()\n  +OnFrameworkInitializationCompleted()\n}\n\nclass ViewLocator {\n  +Build(param : object) : Control\n  +Match(data : object) : bool\n}\n\n&#39; ===== Views =====\npackage \&quot;Views\&quot; {\n  class MainWindow {\n    -_canClose : bool\n    +MainWindow()\n    #OnClosing(e : WindowClosingEventArgs)\n  }\n}\n\n&#39; ===== ViewModels =====\npackage \&quot;ViewModels\&quot; {\n  abstract class ViewModelBase\n\n  class MainViewModel {\n    -_dialogs : IDialogService\n    -_drive : GoogleDriveService\n    -_selectedFilePath : string\n    -_selectedStrategy : string\n    -_selectedFaculty : string\n    -_selectedCourse : string\n    -_selectedRoom : string\n    -_exportFormat : string\n    -_exportTarget : string\n    -_statusMessage : string\n    +SelectedFilePath : string\n    +SelectedStrategy : string\n    +SelectedFaculty : string\n    +SelectedCourse : string\n    +SelectedRoom : string\n    +ExportFormat : string\n    +ExportTarget : string\n    +StatusMessage : string\n    +Faculties : ObservableCollection&lt;string&gt;\n    +Courses : ObservableCollection&lt;string&gt;\n    +Rooms : ObservableCollection&lt;string&gt;\n    +SearchResults : ObservableCollection&lt;StudentRecord&gt;\n    +Strategies : string[]\n    +ExportFormats : string[]\n    +ExportTargets : string[]\n    +OpenXmlCommand : IAsyncRelayCommand\n    +TransformToHtmlCommand : IAsyncRelayCommand\n    +SearchCommand : IRelayCommand\n    +ClearCommand : IRelayCommand\n    +ExportCommand : IAsyncRelayCommand\n    +ExitCommand : IRelayCommand\n    +MainViewModel(dialogs : IDialogService)\n    -OpenXmlAsync() : Task\n    -LoadXmlData(path : string)\n    -{static} Fill(target : ObservableCollection&lt;string&gt;, values : IEnumerable&lt;string&gt;)\n    -TransformToHtmlAsync() : Task\n    -Search()\n    -Clear()\n    -CanExport() : bool\n    -ExportAsync() : Task\n    -Exit()\n    +ConfirmExitAsync() : Task&lt;bool&gt;\n  }\n}\n\n&#39; ===== Models =====\npackage \&quot;Models\&quot; {\n  class StudentRecord {\n    +FullName : string\n    +Faculty : string\n    +Department : string\n    +Course : string\n    +RoomNumber : string\n    +Block : string\n    +SettlementDate : string\n  }\n}\n\n&#39; ===== Services =====\npackage \&quot;Services\&quot; {\n  interface IDialogService {\n    +PickXmlFileAsync() : Task&lt;string&gt;\n    +PickSaveFileAsync(suggestedName : string, ext : string) : Task&lt;string&gt;\n    +ConfirmAsync(title : string, message : string) : Task&lt;bool&gt;\n    +CloseMainWindow()\n  }\n\n  class DialogService &lt;&lt;sealed&gt;&gt; {\n    -{static} Main : Window\n    +PickXmlFileAsync() : Task&lt;string&gt;\n    +PickSaveFileAsync(suggestedName : string, ext : string) : Task&lt;string&gt;\n    +ConfirmAsync(title : string, message : string) : Task&lt;bool&gt;\n    +CloseMainWindow()\n  }\n\n  interface IXmlSearchStrategy {\n    +Search(filePath : string, faculty : string, course : string, room : string) : List&lt;StudentRecord&gt;\n  }\n  class SaxSearchStrategy {\n    +Search(filePath, faculty, course, room) : List&lt;StudentRecord&gt;\n  }\n  class DomSearchStrategy {\n    +Search(filePath, faculty, course, room) : List&lt;StudentRecord&gt;\n  }\n  class LinqSearchStrategy {\n    +Search(filePath, faculty, course, room) : List&lt;StudentRecord&gt;\n  }\n\n  interface IExportFormat {\n    +Extension : string\n    +MimeType : string\n    +Build(items : IEnumerable&lt;StudentRecord&gt;) : string\n  }\n  class XmlExportFormat &lt;&lt;sealed&gt;&gt; {\n    +Extension : string\n    +MimeType : string\n    +Build(items : IEnumerable&lt;StudentRecord&gt;) : string\n    -{static} Attr(name : string, value : string) : XAttribute\n  }\n  class HtmlExportFormat &lt;&lt;sealed&gt;&gt; {\n    +Extension : string\n    +MimeType : string\n    +Build(items : IEnumerable&lt;StudentRecord&gt;) : string\n  }\n  class ExportFormatFactory &lt;&lt;static&gt;&gt; {\n    +{static} Create(format : string) : IExportFormat\n  }\n\n  class XsltTransformerService {\n    +TransformToHtml(xmlPath : string, xslPath : string, htmlOutputPath : string)\n  }\n\n  class GoogleDriveService &lt;&lt;sealed&gt;&gt; {\n    -{static} SecretPath : string\n    -{static} TokenDir : string\n    -_service : DriveService\n    +{static} IsConfigured : bool\n    -GetServiceAsync(ct : CancellationToken) : Task&lt;DriveService&gt;\n    +UploadAsync(fileName : string, content : string, mimeType : string, ct : CancellationToken) : Task&lt;string&gt;\n  }\n\n  class EventLogger &lt;&lt;sealed&gt;&gt; {\n    -{static} _instance : EventLogger\n    -{static} _lock : object\n    -_logFilePath : string\n    -EventLogger()\n    +{static} Instance : EventLogger\n    +Log(importanceLevel : string, message : string)\n  }\n}\n\n&#39; ===== Наследование и реализация =====\nAvApplication &lt;|-- App\nAvIDataTemplate &lt;|.. ViewLocator\nAvWindow &lt;|-- MainWindow\nObservableObject &lt;|-- ViewModelBase\nViewModelBase &lt;|-- MainViewModel\n\nIDialogService &lt;|.. DialogService\nIXmlSearchStrategy &lt;|.. SaxSearchStrategy\nIXmlSearchStrategy &lt;|.. DomSearchStrategy\nIXmlSearchStrategy &lt;|.. LinqSearchStrategy\nIExportFormat &lt;|.. XmlExportFormat\nIExportFormat &lt;|.. HtmlExportFormat\n\n&#39; ===== Зависимости и ассоциации =====\nProgram ..&gt; App : Configure&lt;App&gt;\nApp ..&gt; MainWindow : створює\nApp ..&gt; MainViewModel : створює\nApp ..&gt; DialogService : створює\nViewLocator ..&gt; ViewModelBase : Match\n\nMainWindow ..&gt; MainViewModel : DataContext,\\nConfirmExitAsync()\nMainViewModel --&gt; \&quot;1\&quot; IDialogService : _dialogs\nMainViewModel --&gt; \&quot;1\&quot; GoogleDriveService : _drive\nMainViewModel o-- \&quot;0..*\&quot; StudentRecord : SearchResults\nMainViewModel ..&gt; IXmlSearchStrategy : обирає за\\nSelectedStrategy\nMainViewModel ..&gt; SaxSearchStrategy : створює\nMainViewModel ..&gt; DomSearchStrategy : створює\nMainViewModel ..&gt; LinqSearchStrategy : створює\nMainViewModel ..&gt; ExportFormatFactory\nMainViewModel ..&gt; IExportFormat\nMainViewModel ..&gt; XsltTransformerService : створює\nMainViewModel ..&gt; EventLogger\n\nExportFormatFactory ..&gt; XmlExportFormat : створює\nExportFormatFactory ..&gt; HtmlExportFormat : створює\nIXmlSearchStrategy ..&gt; StudentRecord\nIExportFormat ..&gt; StudentRecord\nDialogService ..&gt; AvWindow : Main\nEventLogger --&gt; \&quot;0..1\&quot; EventLogger : _instance\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="NpnuV4jO67nzX4HTN5qH-1">
